<!DOCTYPE html>
<html lang="es">
<head>
    <%- include('partials/head') %>
    <title><%= title %></title>
    <meta name="google-adsense-account" content="ca-pub-8003242291729928">
    <link rel="stylesheet" href="/css/game.css">
    <link rel="stylesheet" href="/css/lamente.css">
</head>
<body class="game lamente">
    <%- include('partials/game_bar', { gameType: 'lamente', title: title, roomId: roomId }) %>

    <div class="lamente-wrapper">
        <div class="container">
        <!-- Entrada -->
        <div id="login-screen" class="card lm-screen">
            <h1>La Mente</h1>
            <h2>Escribe tu nombre para entrar</h2>
            <div class="input-group">
                <input type="text" id="name-input" class="tp-input" placeholder="Tu nombre" maxlength="24" autocomplete="nickname" enterkeyhint="go">
            </div>
            <button id="join-button" class="btn-primary btn-custom">Entrar a la sala</button>
        </div>

        <!-- Espera -->
        <div id="waiting-screen" class="card lm-screen hidden">
            <h1>Sala de espera</h1>
            <h2 id="countdown-timer" aria-live="polite">Esperando a que el admin inicie la partida...</h2>
            <h3>En la sala</h3>
            <div id="player-list">
                <!-- Jugadores -->
            </div>
            <p class="lm-tip"><i class="bi bi-chat-square-dots"></i> Recordad: durante la partida no se puede hablar.</p>
        </div>

        <!-- Partida -->
        <div id="game-screen" class="card lm-screen hidden">
            <h1>Tu número</h1>
            <div class="code-display">
                <span id="player-number" class="code">?</span>
            </div>
            <h3 id="game-info">Rango: 1-100 | Faltan: ? jugadores</h3>
            <button id="voy-button" class="btn-secondary">VOY</button>
        </div>

        <!-- Fin de partida -->
        <div id="game-over-screen" class="card lm-screen hidden">
            <h1 id="game-over-title">¡Habéis perdido!</h1>
            <h2 id="game-over-reason"></h2>
            <h3>Orden de la partida</h3>
            <div id="results-list">
                <!-- Resultados -->
            </div>
            <h2 id="next-game-countdown"></h2>
        </div>
        </div>
    </div>

    <script src="/socket.io/socket.io.js"></script>
    <script src="/js/lamente.js"></script>
    <%- include('partials/analytics') %>
</body>
</html>

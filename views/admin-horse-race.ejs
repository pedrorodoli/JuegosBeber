<!DOCTYPE html>
<html lang="es">
<head>
    <%- include('partials/head', { ads: true }) %>
    <title><%= title %></title>
    <meta name="description" content="<%= typeof description !== 'undefined' ? description : 'Crea tu propia sala de juegos beber online.' %>">
    <link rel="stylesheet" href="/css/admin.css">
</head>
<body class="admin-page">
    <%- include('partials/topbar', { back: '/rooms/horse-race', backLabel: 'Volver a las salas' }) %>

    <main class="admin-main">
        <header class="admin-head">
            <h1 class="tp-rise">Nueva sala</h1>
            <p class="tp-rise" style="--i:1"><strong>Carrera de Caballos.</strong> <%= typeof description !== 'undefined' ? description : '' %></p>
        </header>

        <form id="create-race-form" class="admin-form tp-panel tp-rise" style="--i:2" novalidate>
            <div class="tp-field">
                <label class="tp-label" for="name">Nombre de la sala</label>
                <input class="tp-input" type="text" id="name" name="name" placeholder="Carrera loca #1" maxlength="40" required autocomplete="off">
            </div>
            <div class="tp-field">
                <label class="tp-label" for="password">Contraseña <span class="tp-optional">opcional</span></label>
                <input class="tp-input" type="password" id="password" name="password" placeholder="Déjala vacía para una sala pública" autocomplete="new-password">
            </div>
            <div class="tp-field">
                <label class="tp-label" for="maxBet">Apuesta máxima (tragos)</label>
                <div class="tp-stepper">
                    <button type="button" data-step="-1" aria-label="Menos">−</button>
                    <input class="tp-input" type="number" inputmode="numeric" id="maxBet" name="maxBet" value="10" min="1">
                    <button type="button" data-step="1" aria-label="Más">+</button>
                </div>
                <span class="tp-hint">Lo máximo que puede apostar cada jugador.</span>
            </div>
            <div class="tp-field">
                <label class="tp-label" for="prizeMultiplier">Multiplicador del premio</label>
                <div class="tp-stepper">
                    <button type="button" data-step="-1" aria-label="Menos">−</button>
                    <input class="tp-input" type="number" inputmode="numeric" id="prizeMultiplier" name="prizeMultiplier" value="2" min="1">
                    <button type="button" data-step="1" aria-label="Más">+</button>
                </div>
                <span class="tp-hint">El ganador reparte su apuesta multiplicada por esto.</span>
            </div>
            <p class="tp-form-error" role="alert" hidden></p>
            <button type="submit" class="tp-btn tp-btn--block admin-submit">Crear sala <i class="bi bi-arrow-right"></i></button>
        </form>

        <section class="admin-rules tp-rise" style="--i:3">
            <%- include('partials/game_rules', { gameType: 'horse-race' }) %>
        </section>
    </main>

    <%- include('partials/footer') %>
    <script src="/js/create-room.js"></script>
    <script>
        tpCreateRoom({
            gameType: 'horse-race',
            form: 'create-race-form',
            build: function (form) {
                const nameInput = document.getElementById('name');
                if (!nameInput.value.trim()) { nameInput.focus(); throw new Error('Ponle un nombre a la sala.'); }
                return {
                    name: nameInput.value,
                    password: document.getElementById('password').value,
                    settings: { maxBet: parseInt(document.getElementById('maxBet').value), prizeMultiplier: parseInt(document.getElementById('prizeMultiplier').value) }
                };
            }
        });
    </script>
    <%- include('partials/analytics') %>
</body>
</html>

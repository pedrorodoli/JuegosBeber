<!DOCTYPE html>
<html lang="es">
<head>
    <%- include('partials/head', { ads: true }) %>
    <title><%= title %></title>
    <meta name="description" content="<%= typeof description !== 'undefined' ? description : 'Crea tu propia sala de juegos beber online.' %>">
    <link rel="stylesheet" href="/css/admin.css">
</head>
<body class="admin-page">
    <%- include('partials/topbar', { back: '/rooms/lamente', backLabel: 'Volver a las salas' }) %>

    <main class="admin-main">
        <!-- Pantalla 1: crear sala -->
        <div id="create-room-screen">
            <header class="admin-head">
                <h1 class="tp-rise">Nueva sala</h1>
                <p class="tp-rise" style="--i:1"><strong>La Mente.</strong> Tú creas la sala y eliges el rango de números. Los demás entran con el enlace.</p>
            </header>
            <form id="create-room-form" class="admin-form tp-panel tp-rise" style="--i:2; margin-top:1.5rem">
                <div class="tp-field">
                    <label class="tp-label" for="admin-name">Tu nombre</label>
                    <input class="tp-input" type="text" id="admin-name" required placeholder="Cómo te verán los demás" maxlength="24" autocomplete="nickname">
                </div>
                <div class="tp-field">
                    <label class="tp-label" for="room-name">Nombre de la sala</label>
                    <input class="tp-input" type="text" id="room-name" required value="Sala de La Mente" maxlength="40" autocomplete="off">
                </div>
                <div class="tp-field">
                    <label class="tp-label" for="room-password">Contraseña <span class="tp-optional">opcional</span></label>
                    <input class="tp-input" type="text" id="room-password" placeholder="Déjala vacía para una sala pública" autocomplete="off">
                </div>
                <button type="submit" class="tp-btn tp-btn--block admin-submit">Crear y entrar <i class="bi bi-arrow-right"></i></button>
            </form>
        </div>

        <!-- Pantalla 2: panel del anfitrión -->
        <div id="admin-panel-screen" class="hidden">
            <header class="admin-head">
                <h1 id="admin-room-name" class="tp-rise">Panel de la sala</h1>
                <p class="tp-rise" style="--i:1">Elige el rango de números y empieza cuando estéis todos.</p>
            </header>
            <div class="admin-form tp-panel tp-rise" style="--i:2; margin-top:1.5rem">
                <div class="admin-grid">
                    <div class="tp-field">
                        <label class="tp-label" for="min-range">Desde</label>
                        <div class="tp-stepper">
                            <button type="button" data-step="-1" aria-label="Menos">−</button>
                            <input class="tp-input" type="number" inputmode="numeric" id="min-range" value="1">
                            <button type="button" data-step="1" aria-label="Más">+</button>
                        </div>
                    </div>
                    <div class="tp-field">
                        <label class="tp-label" for="max-range">Hasta</label>
                        <div class="tp-stepper">
                            <button type="button" data-step="-1" aria-label="Menos">−</button>
                            <input class="tp-input" type="number" inputmode="numeric" id="max-range" value="100">
                            <button type="button" data-step="1" aria-label="Más">+</button>
                        </div>
                    </div>
                </div>
                <button id="start-game-button" class="tp-btn tp-btn--block admin-submit">Iniciar partida</button>
            </div>
            <section class="tp-panel admin-players tp-rise" style="--i:3; margin-top:1rem">
                <h2>En la sala</h2>
                <div id="admin-player-list" class="admin-player-list"></div>
            </section>
        </div>

        <section class="admin-rules tp-rise" style="--i:4">
            <%- include('partials/game_rules', { gameType: 'lamente' }) %>
        </section>
    </main>

    <%- include('partials/footer') %>
    <script src="/js/create-room.js"></script>
    <script src="/socket.io/socket.io.js"></script>
    <script src="/js/admin-lamente.js"></script>
    <%- include('partials/analytics') %>
</body>
</html>

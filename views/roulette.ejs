<!DOCTYPE html>
<html lang="es">
<head>
    <%- include('partials/head') %>
    <title><%= title %></title>
    <meta name="google-adsense-account" content="ca-pub-8003242291729928">
    <link rel="stylesheet" href="/css/toastify.min.css">
    <link rel="stylesheet" href="/css/game.css">
    <link rel="stylesheet" href="/css/roulette.css">
</head>
<body class="game roulette">
    <%- include('partials/game_bar', { gameType: 'roulette', title: title, roomId: roomId }) %>

    <!-- 0. Entrada -->
    <div id="lobby-view" class="overlay-container modal-overlay">
        <div class="card-view modal-content">
            <h2>Ruleta de la suerte</h2>
            <p>Escribe tu nombre para sentarte a la mesa.</p>
            <form id="join-lobby-form">
                <input type="text" id="playerName" placeholder="Tu nombre" required autocomplete="nickname" maxlength="24" enterkeyhint="go">
                <button type="submit" class="btn-custom">Sentarme</button>
            </form>
        </div>
    </div>

    <!-- Partida -->
    <div id="game-wrapper">
        <div id="player-sidebar">
            <div class="rl-status">
                <div id="betting-timer" class="rl-timer" aria-live="polite"></div>
                <div id="admin-controls" style="display: none;">
                    <button id="start-game-btn" class="btn-custom"><i class="bi bi-play-fill"></i> Empezar partida</button>
                </div>
            </div>
            <ul id="player-list" class="rl-players"></ul>
            <div id="turn-notifications" aria-live="polite"></div>
        </div>
        <div id="game-container"></div>
    </div>

    <!-- Reparto de tragos -->
    <div id="distribution-view" style="display: none;" class="overlay-container modal-overlay">
        <div class="card-view modal-content">
            <h2>Reparte tragos</h2>
            <p>Gasta tus puntos en tragos para los demás.</p>
            <div id="distribution-info">
                <div><span>Tu saldo</span><strong><span id="dist-total-sips">0</span> pts</strong></div>
                <div><span>Te queda</span><strong><span id="dist-remaining-sips">0</span> pts</strong></div>
            </div>
            <div id="distribution-form">
                <ul id="distribution-player-list"></ul>
                <div class="rl-dist-actions">
                    <button id="skip-distribution-btn" class="tp-btn tp-btn--ghost">Omitir</button>
                    <button id="distribute-btn" class="btn-custom">Repartir</button>
                </div>
            </div>
        </div>
    </div>

    <!-- Sin puntos -->
    <div id="out-of-points-view" style="display: none;" class="overlay-container modal-overlay">
        <div class="card-view modal-content rl-broke">
            <span class="rl-broke-icon" aria-hidden="true"><i class="bi bi-cup-straw"></i></span>
            <h2>Sin puntos</h2>
            <p>Bebe 5 tragos para volver a jugar.</p>
            <p>(Estarás fuera durante esta ronda)</p>
        </div>
    </div>

    <script src="/socket.io/socket.io.js"></script>
    <script src="/js/toastify.min.js"></script>
    <script src="/js/roulette.js"></script>
    <%- include('partials/analytics') %>
</body>
</html>

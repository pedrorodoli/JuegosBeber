<!DOCTYPE html>
<html lang="es">
<head>
    <%- include('partials/head') %>
    <title><%= title %></title>
    <link rel="stylesheet" href="/css/game.css">
    <link rel="stylesheet" href="/css/voting.css">
</head>
<body class="game voting">
    <%- include('partials/game_bar', { gameType: 'voting', title: title, roomId: roomId }) %>

    <div class="voting-wrapper">
        <section id="game-voting" class="section">
            <div id="game-countdown" class="countdown-progress-container" aria-live="off">
                <div class="countdown-progress-bar"></div>
                <span class="countdown-text"></span>
            </div>
            <h1 id="game-page-title" class="g-question">Votación</h1>
            <div id="game-container">
                <!-- Las opciones de voto se generan con JS -->
                <p>Cargando opciones de la votación...</p>
            </div>
        </section>
    </div>

    <!-- Overlay de resultado (no usado por el script actual, se mantiene oculto) -->
    <div id="result-overlay" hidden>
        <div class="result-content">
            <h2>La votación ha terminado</h2>
            <p>El ganador es...</p>
            <div id="winner-name" class="winner-name"></div>
        </div>
    </div>

    <script>
        const GAME_TYPE = "<%= gameType %>";
        const ROOM_ID = "<%= roomId %>";
    </script>
    <script src="/socket.io/socket.io.js"></script>
    <script src="/js/voting.js"></script>
    <%- include('partials/analytics') %>
</body>
</html>

<!DOCTYPE html>
<html lang="es">
<head>
    <%- include('partials/head', { ads: true }) %>
    <title><%= title %></title>
    <meta name="description" content="<%= typeof description !== 'undefined' ? description : 'Crea tu propia sala de juegos beber online.' %>">
    <link rel="stylesheet" href="/css/admin.css">
</head>
<body class="admin-page">
    <%- include('partials/topbar', { back: '/rooms/imitador', backLabel: 'Volver a las salas' }) %>

    <main class="admin-main">
        <header class="admin-head">
            <h1 class="tp-rise">Nueva sala</h1>
            <p class="tp-rise" style="--i:1"><strong>El Imitador.</strong> <%= typeof description !== 'undefined' ? description : '' %></p>
        </header>

        <form id="create-imitador-form" class="admin-form tp-panel tp-rise" style="--i:2" novalidate>
            <div class="tp-field">
                <label class="tp-label" for="roomName">Nombre de la sala</label>
                <input class="tp-input" type="text" id="roomName" name="roomName" placeholder="Sala de imitadores" maxlength="40" required autocomplete="off">
            </div>
            <div class="tp-field">
                <label class="tp-label" for="roomPassword">Contraseña <span class="tp-optional">opcional</span></label>
                <input class="tp-input" type="password" id="roomPassword" name="password" placeholder="Déjala vacía para una sala pública" autocomplete="new-password">
            </div>

            <p class="tp-form-error" role="alert" hidden></p>
            <button type="submit" class="tp-btn tp-btn--block admin-submit">Crear sala <i class="bi bi-arrow-right"></i></button>
        </form>

        <section class="admin-rules tp-rise" style="--i:3">
            <%- include('partials/game_rules', { gameType: 'imitador' }) %>
        </section>
    </main>

    <%- include('partials/footer') %>
    <script src="/js/create-room.js"></script>
    <script>
        tpCreateRoom({
            gameType: 'imitador',
            form: 'create-imitador-form',
            build: function (form) {
                const nameInput = document.getElementById('roomName');
                if (!nameInput.value.trim()) { nameInput.focus(); throw new Error('Ponle un nombre a la sala.'); }
                return {
                    name: nameInput.value,
                    password: document.getElementById('roomPassword').value,
                    settings: {}
                };
            }
        });
    </script>
    <%- include('partials/analytics') %>
</body>
</html>

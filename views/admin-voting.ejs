<!DOCTYPE html>
<html lang="es">
<head>
    <%- include('partials/head', { ads: true }) %>
    <title><%= title %></title>
    <meta name="description" content="<%= typeof description !== 'undefined' ? description : 'Crea tu propia sala de juegos beber online.' %>">
    <link rel="stylesheet" href="/css/admin.css">
</head>
<body class="admin-page">
    <%- include('partials/topbar', { back: '/rooms/voting', backLabel: 'Volver a las salas' }) %>

    <main class="admin-main">
        <header class="admin-head">
            <h1 class="tp-rise">Nueva votación</h1>
            <p class="tp-rise" style="--i:1">Escribe la pregunta y las opciones. Todos votan en secreto y al acabar el tiempo se ve el resultado.</p>
        </header>

        <form id="create-voting-form" class="admin-form tp-panel tp-rise" style="--i:2" novalidate>
            <div class="tp-field">
                <label class="tp-label" for="name">Pregunta</label>
                <input class="tp-input" type="text" id="name" placeholder="¿Quién es más probable que...?" maxlength="80" required autocomplete="off">
            </div>
            <div class="tp-field">
                <label class="tp-label" for="password">Contraseña <span class="tp-optional">opcional</span></label>
                <input class="tp-input" type="password" id="password" placeholder="Déjala vacía para una sala pública" autocomplete="new-password">
            </div>
            <div class="tp-field">
                <span class="tp-label" id="options-label">Opciones</span>
                <div id="options-container" class="options-editor" aria-labelledby="options-label">
                    <div class="option-input-group">
                        <input type="text" class="tp-input" name="options" placeholder="Opción 1" maxlength="60" required>
                        <button type="button" class="remove-option-btn" aria-label="Quitar opción"><i class="bi bi-x-lg"></i></button>
                    </div>
                    <div class="option-input-group">
                        <input type="text" class="tp-input" name="options" placeholder="Opción 2" maxlength="60" required>
                        <button type="button" class="remove-option-btn" aria-label="Quitar opción"><i class="bi bi-x-lg"></i></button>
                    </div>
                </div>
                <button type="button" id="add-option-btn" class="tp-btn tp-btn--ghost tp-btn--sm add-option"><i class="bi bi-plus-lg"></i> Añadir opción</button>
                <span class="tp-hint">Pulsa Intro para saltar a la siguiente opción.</span>
            </div>
            <div class="tp-field">
                <label class="tp-label" for="duration">Tiempo para votar (s)</label>
                <div class="tp-stepper">
                    <button type="button" data-step="-1" aria-label="Menos">−</button>
                    <input class="tp-input" type="number" inputmode="numeric" id="duration" value="60" min="1" step="5" required>
                    <button type="button" data-step="1" aria-label="Más">+</button>
                </div>
            </div>
            <button type="submit" class="tp-btn tp-btn--block admin-submit">Crear votación <i class="bi bi-arrow-right"></i></button>
        </form>

        <section class="admin-rules tp-rise" style="--i:3">
            <%- include('partials/game_rules', { gameType: 'voting' }) %>
        </section>
    </main>

    <%- include('partials/footer') %>
    <script src="/js/create-room.js"></script>
    <script>
        const gameType = 'voting';

        function showToast(message) {
            tpToast(message, { error: true });
        }

        // Function to attach keydown listener to option inputs
        function attachKeydownListenerToOptions(inputElement) {
            inputElement.addEventListener('keydown', (e) => {
                if (e.key === 'Enter') {
                    e.preventDefault(); // Prevent form submission

                    const currentInput = e.target;
                    const optionsInputs = Array.from(document.getElementsByName('options'));
                    const currentIndex = optionsInputs.indexOf(currentInput);

                    let nextInput = null;

                    // Try to find the next empty input field
                    for (let i = currentIndex + 1; i < optionsInputs.length; i++) {
                        if (optionsInputs[i].value.trim() === '') {
                            nextInput = optionsInputs[i];
                            break;
                        }
                    }

                    if (nextInput) {
                        nextInput.focus(); // Focus on the next empty field
                    } else {
                        // If no next empty field, add a new one
                        document.getElementById('add-option-btn').click();
                        // The newly added input will be the last one
                        setTimeout(() => {
                            const newOptionsInputs = Array.from(document.getElementsByName('options'));
                            newOptionsInputs[newOptionsInputs.length - 1].focus();
                        }, 0); // Use setTimeout to allow DOM to update
                    }
                }
            });
        }

        document.addEventListener('DOMContentLoaded', () => {
            // Attach keydown listener to initial inputs
            document.querySelectorAll('input[name="options"]').forEach(attachKeydownListenerToOptions);

            document.getElementById('add-option-btn').addEventListener('click', () => {
                const container = document.getElementById('options-container');
                const newOption = document.createElement('div');
                newOption.className = 'option-input-group';
                newOption.innerHTML = `
                    <input type="text" class="tp-input" name="options" placeholder="Otra opción" maxlength="60" required>
                    <button type="button" class="remove-option-btn" aria-label="Quitar opción"><i class="bi bi-x-lg"></i></button>
                `;
                container.appendChild(newOption);
                
                // Attach listener to the newly created input and focus it
                const newAddedInput = newOption.querySelector('input[name="options"]');
                attachKeydownListenerToOptions(newAddedInput);
                newAddedInput.focus();
            });

            document.getElementById('options-container').addEventListener('click', (e) => {
                const rm = e.target.closest('.remove-option-btn');
                if (rm) {
                    if (document.getElementsByName('options').length > 2) {
                        const g = rm.closest('.option-input-group'); g.classList.add('is-leaving'); setTimeout(() => g.remove(), 180);
                    } else {
                        showToast('Debe haber al menos dos opciones.');
                    }
                }
            });

            document.getElementById('create-voting-form').addEventListener('submit', async (e) => {
                e.preventDefault();

                const nameInput = document.getElementById('name');
                if (!nameInput.value.trim()) {
                    showToast("Falta el título de la votación");
                    nameInput.focus();
                    return;
                }

                const optionsInputs = Array.from(document.getElementsByName('options'));
                let hasEmptyOption = false;
                for (let input of optionsInputs) {
                    if (!input.value.trim()) {
                        showToast("Falta rellenar una de las opciones");
                        input.focus();
                        hasEmptyOption = true;
                        break;
                    }
                }
                if (hasEmptyOption) return;

                const urlParams = new URLSearchParams(window.location.search);
                const updateRoomId = urlParams.get('update_room_id');

                let userUUID = localStorage.getItem('userUUID');
                if (!userUUID) {
                    userUUID = 'xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx'.replace(/[xy]/g, c => {
                        const r = Math.random() * 16 | 0, v = c == 'x' ? r : (r & 0x3 | 0x8);
                        return v.toString(16);
                    });
                    localStorage.setItem('userUUID', userUUID);
                }

                const options = optionsInputs.map(input => input.value).filter(val => val.trim() !== '');
                if (options.length < 2) {
                    showToast('Debes proporcionar al menos dos opciones válidas.');
                    return;
                }

                const payload = {
                    name: document.getElementById('name').value,
                    password: document.getElementById('password').value,
                    creatorId: userUUID,
                    settings: {
                        options: options,
                        duration: parseInt(document.getElementById('duration').value)
                    }
                };

                if (updateRoomId) {
                    payload.update_room_id = updateRoomId;
                }

                const response = await fetch(`/api/rooms/${gameType}`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(payload)
                });

                if (response.ok) {
                    const { roomId } = await response.json();
                    window.location.href = `/game/${gameType}/${roomId}`;
                } else {
                    showToast('No se pudo crear la votación. Inténtalo de nuevo.');
                }
            });

            // Pre-fill form if update_room_id is present
            const urlParams = new URLSearchParams(window.location.search);
            const updateRoomId = urlParams.get('update_room_id');

            if (updateRoomId) {
                const lastVotingSettings = JSON.parse(localStorage.getItem('lastVotingSettings'));
                if (lastVotingSettings) {
                    document.getElementById('name').value = lastVotingSettings.name;
                    document.getElementById('duration').value = lastVotingSettings.duration;

                    const optionsContainer = document.getElementById('options-container');
                    optionsContainer.innerHTML = ''; // Clear existing options

                    lastVotingSettings.options.forEach(optionText => {
                        const newOption = document.createElement('div');
                        newOption.className = 'option-input-group';
                        newOption.innerHTML = `
                            <input type="text" class="tp-input" name="options" value="${escapeHTML(optionText)}" maxlength="60" required>
                            <button type="button" class="remove-option-btn" aria-label="Quitar opción"><i class="bi bi-x-lg"></i></button>
                        `;
                        optionsContainer.appendChild(newOption);
                        attachKeydownListenerToOptions(newOption.querySelector('input[name="options"]'));
                    });
                    // Ensure at least two options if original had less
                    while (document.getElementsByName('options').length < 2) {
                        document.getElementById('add-option-btn').click();
                    }
                }
            }
        });

        // Helper to escape HTML for pre-filling values
        function escapeHTML(str) {
            const div = document.createElement('div');
            div.appendChild(document.createTextNode(str));
            return div.innerHTML;
        }
    </script>
    <%- include('partials/analytics') %>
</body>
</html>

<!DOCTYPE html>
<html lang="es">
<head>
    <%- include('partials/head', { ads: true }) %>
    <title><%= title %></title>
    <meta name="description" content="<%= typeof description !== 'undefined' ? description : 'Encuentra y únete a salas de juegos beber online en JuegosBeber.es. Diversión multijugador en tiempo real.' %>">

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website">
    <meta property="og:title" content="<%= title %>">
    <meta property="og:description" content="<%= typeof description !== 'undefined' ? description : 'Encuentra y únete a salas de juegos beber online en JuegosBeber.es. Diversión multijugador en tiempo real.' %>">
    <meta property="og:image" content="https://juegosbeber.es/images/icono.png">

    <link rel="stylesheet" href="/css/rooms.css">
    <script src="/socket.io/socket.io.js"></script>
</head>
<body class="rooms-page">
    <%- include('partials/topbar', { back: '/', backLabel: 'Volver a los juegos' }) %>

    <main class="rooms-main">
        <header class="rooms-head">
            <h1 class="tp-rise"><%= title %></h1>
            <% if (typeof description !== 'undefined' && description) { %>
                <p class="tp-rise" style="--i:1"><%= description %></p>
            <% } %>
            <a href="/admin/<%= gameType %>" class="tp-btn rooms-create tp-rise" style="--i:2"><i class="bi bi-plus-lg"></i> Crear sala</a>
        </header>

        <section class="rooms-list-wrap tp-rise" style="--i:3" aria-labelledby="public-title">
            <div class="rooms-list-head">
                <h2 id="public-title">Salas abiertas</h2>
                <span class="live" title="La lista se actualiza sola"><span class="live-dot"></span> En directo</span>
            </div>
            <div id="public-rooms-list">
                <ul class="room-list" id="room-list-container">
                    <% if (rooms.length > 0) { %>
                        <% rooms.forEach(room => { %>
                            <li class="room-row">
                                <span class="room-icon" aria-hidden="true"><i class="bi <%= room.hasPassword ? 'bi-lock-fill' : 'bi-door-open-fill' %>"></i></span>
                                <span class="room-info">
                                    <span class="room-name"><%= room.name %></span>
                                    <span class="room-meta"><span class="num"><%= room.playerCount %></span> <%= room.playerCount === 1 ? 'jugador' : 'jugadores' %><% if (room.hasPassword) { %> · con contraseña<% } %></span>
                                </span>
                                <button class="tp-btn tp-btn--chalk tp-btn--sm btn-join" onclick="handleJoinRoom('<%= room.id %>', <%= room.hasPassword %>)">Unirse</button>
                            </li>
                        <% }) %>
                    <% } else { %>
                        <li class="rooms-empty">
                            <span class="rooms-empty-art" aria-hidden="true"><i class="bi bi-suit-spade-fill"></i></span>
                            <strong>Aún no hay salas abiertas</strong>
                            <span>Crea una y pasa el enlace al grupo. Aparecerá aquí al momento.</span>
                        </li>
                    <% } %>
                </ul>
            </div>
        </section>

        <section class="rooms-rules tp-rise" style="--i:4">
            <%- include('partials/game_rules', { gameType: gameType }) %>
        </section>
    </main>

    <%- include('partials/footer') %>

    <script>
        const gameType = '<%= gameType %>';
    </script>
    <script src="/js/rooms.js"></script>
    <%- include('partials/analytics') %>
</body>
</html>

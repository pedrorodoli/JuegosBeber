<!DOCTYPE html>
<html lang="es">
<head>
    <%- include('partials/head', { ads: true }) %>
    <title><%= title %></title>
    <meta name="description" content="<%= typeof description !== 'undefined' ? description : 'Crea tu propia sala de juegos beber online.' %>">
    <link rel="stylesheet" href="/css/admin.css">
</head>
<body class="admin-page">
    <%- include('partials/topbar', { back: '/rooms/roulette', backLabel: 'Volver a las salas' }) %>

    <main class="admin-main">
        <header class="admin-head">
            <h1 class="tp-rise">Nueva sala</h1>
            <p class="tp-rise" style="--i:1"><strong>Ruleta.</strong> <%= typeof description !== 'undefined' ? description : '' %></p>
        </header>

        <form id="create-room-form" class="admin-form tp-panel tp-rise" style="--i:2" novalidate>
            <div class="tp-field">
                <label class="tp-label" for="name">Nombre de la sala</label>
                <input class="tp-input" type="text" id="name" name="name" placeholder="La ruleta de la suerte" maxlength="40" required autocomplete="off">
            </div>
            <div class="tp-field">
                <label class="tp-label" for="password">Contraseña <span class="tp-optional">opcional</span></label>
                <input class="tp-input" type="password" id="password" name="password" placeholder="Déjala vacía para una sala pública" autocomplete="new-password">
            </div>
            <div class="admin-grid">
            <div class="tp-field">
                <label class="tp-label" for="initialSips">Saldo inicial (puntos)</label>
                <div class="tp-stepper">
                    <button type="button" data-step="-1" aria-label="Menos">−</button>
                    <input class="tp-input" type="number" inputmode="numeric" id="initialSips" name="initialSips" value="100" min="1">
                    <button type="button" data-step="1" aria-label="Más">+</button>
                </div>
                <span class="tp-hint">Puntos con los que empieza cada jugador.</span>
            </div>
            <div class="tp-field">
                <label class="tp-label" for="bettingTime">Tiempo para apostar (s)</label>
                <div class="tp-stepper">
                    <button type="button" data-step="-1" aria-label="Menos">−</button>
                    <input class="tp-input" type="number" inputmode="numeric" id="bettingTime" name="bettingTime" value="30" min="10">
                    <button type="button" data-step="1" aria-label="Más">+</button>
                </div>
            </div>
            <div class="tp-field">
                <label class="tp-label" for="drinkPrice">Precio del trago (puntos)</label>
                <div class="tp-stepper">
                    <button type="button" data-step="-1" aria-label="Menos">−</button>
                    <input class="tp-input" type="number" inputmode="numeric" id="drinkPrice" name="drinkPrice" value="20" min="1">
                    <button type="button" data-step="1" aria-label="Más">+</button>
                </div>
            </div>
            <div class="tp-field">
                <label class="tp-label" for="zeroSipsPenalty">Penalización (tragos)</label>
                <div class="tp-stepper">
                    <button type="button" data-step="-1" aria-label="Menos">−</button>
                    <input class="tp-input" type="number" inputmode="numeric" id="zeroSipsPenalty" name="zeroSipsPenalty" value="5" min="0">
                    <button type="button" data-step="1" aria-label="Más">+</button>
                </div>
                <span class="tp-hint">Tragos que bebe quien se queda sin puntos.</span>
            </div>
            </div>
            <p class="tp-form-error" role="alert" hidden></p>
            <button type="submit" class="tp-btn tp-btn--block admin-submit">Crear sala <i class="bi bi-arrow-right"></i></button>
        </form>

        <section class="admin-rules tp-rise" style="--i:3">
            <%- include('partials/game_rules', { gameType: 'roulette' }) %>
        </section>
    </main>

    <%- include('partials/footer') %>
    <script src="/js/create-room.js"></script>
    <script>
        tpCreateRoom({
            gameType: 'roulette',
            form: 'create-room-form',
            build: function (form) {
                const nameInput = document.getElementById('name');
                if (!nameInput.value.trim()) { nameInput.focus(); throw new Error('Ponle un nombre a la sala.'); }
                return {
                    name: nameInput.value,
                    password: document.getElementById('password').value,
                    settings: { initialSips: parseInt(document.getElementById('initialSips').value, 10), bettingTime: parseInt(document.getElementById('bettingTime').value, 10), drinkPrice: parseInt(document.getElementById('drinkPrice').value, 10), zeroSipsPenalty: parseInt(document.getElementById('zeroSipsPenalty').value, 10) }
                };
            }
        });
    </script>
    <%- include('partials/analytics') %>
</body>
</html>

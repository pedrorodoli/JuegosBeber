<!DOCTYPE html>
<html lang="es">
<head>
    <%- include('partials/head') %>
    <title><%= typeof title !== 'undefined' ? title : 'Juego del Imitador' %></title>
    <meta name="google-adsense-account" content="ca-pub-8003242291729928">
    <link rel="stylesheet" href="/css/toastify.min.css">
    <link rel="stylesheet" href="/css/game.css">
    <link rel="stylesheet" href="/css/imitador.css">
    <script src="/socket.io/socket.io.js"></script>
    <script src="/js/toastify.min.js"></script>
</head>
<body class="game imitador">
    <%- include('partials/game_bar', { gameType: 'imitador', title: (typeof title !== 'undefined' ? title : 'El Imitador'), roomId: roomId }) %>

    <div class="main-wrapper">
        <div class="container">
            <div id="game-area" class="imitador-container" aria-live="polite">
                <!-- Contenido generado por JS -->
                <div class="im-loading"><span class="tp-spinner"></span> Entrando en la sala</div>
            </div>

            <!-- Controles del anfitrión -->
            <div id="admin-controls" class="im-admin" style="display: none;">
                <button id="btn-start" class="btn-custom">
                    <i class="bi bi-shuffle"></i> Repartir
                </button>
            </div>
        </div>
    </div>

    <!-- Nombre -->
    <div id="name-modal" class="modal-overlay" style="display: none;">
        <div class="modal-content">
            <h2>¿Cómo te llamas?</h2>
            <p>Así te verán los demás en la partida.</p>
            <input type="text" id="name-input" placeholder="Tu nombre" maxlength="24" autocomplete="nickname" enterkeyhint="go">
            <button id="join-game-btn" class="btn-custom">Entrar a jugar</button>
        </div>
    </div>

    <script>
        const roomId = '<%= roomId %>';
        const gameType = '<%= gameType %>';
    </script>
    <script src="/js/imitador.js"></script>
    <%- include('partials/analytics') %>
</body>
</html>

<!DOCTYPE html>
<html lang="es">
<head>
    <%- include('partials/head') %>
    <title><%= title %></title>
    <meta name="google-adsense-account" content="ca-pub-8003242291729928">
    <link rel="stylesheet" href="/css/toastify.min.css">
    <link rel="stylesheet" href="/css/game.css">
    <link rel="stylesheet" href="/css/pyramid.css">
</head>
<body class="game pyramid">
    <%- include('partials/game_bar', { gameType: 'pyramid', title: title, roomId: roomId }) %>

    <section class="g-players" id="player-list-card" aria-label="Jugadores">
        <ul id="player-list"></ul>
    </section>

    <main class="g-table game-main-area">
        <div id="pyramid-area">
            <!-- Las cartas de la pirámide se generarán aquí -->
        </div>
        <section class="py-log" id="actions-log-area" aria-label="Últimas jugadas">
            <div id="actions-log" aria-live="polite"></div>
        </section>
    </main>

    <footer class="g-dock player-footer">
        <h2 class="g-dock-title">Tus cartas</h2>
        <div id="player-hand"></div>
        <div id="player-actions" class="g-actions">
            <!-- Botones generados por JS -->
        </div>
        <div id="my-drinks-count" aria-live="polite"></div>
    </footer>

    <!-- Nombre -->
    <div id="name-modal" class="modal-overlay">
        <div class="modal-content">
            <h2>¿Cómo te llamas?</h2>
            <p>Así te verán los demás en la partida.</p>
            <input type="text" id="name-input" placeholder="Tu nombre" maxlength="24" autocomplete="nickname" enterkeyhint="go">
            <button id="join-game-btn" class="btn-custom">Entrar a jugar</button>
        </div>
    </div>

    <!-- Elegir a quién mandar beber -->
    <div id="target-modal" class="modal-overlay" style="display: none;">
        <div class="modal-content">
            <h2>¿A quién mandas beber?</h2>
            <p>Elige a un jugador. Puede aceptar o desafiarte.</p>
            <div id="target-player-list"></div>
            <button id="cancel-target-btn" class="tp-btn tp-btn--ghost tp-btn--block">Cancelar</button>
        </div>
    </div>

    <!-- Te mandan beber -->
    <div id="challenge-modal" class="modal-overlay" style="display: none;">
        <div class="modal-content challenge-sheet">
            <h2 id="challenge-title">Te mandan beber</h2>
            <p id="challenge-text"></p>
            <div id="challenge-pyramid-card"></div>
            <div class="challenge-actions">
                <button id="challenge-accept-btn" class="tp-btn tp-btn--chalk">Beber</button>
                <button id="challenge-reject-btn" class="btn-custom">Desafiar</button>
            </div>
        </div>
    </div>

    <script src="/socket.io/socket.io.js"></script>
    <script src="/js/toastify.min.js"></script>
    <script src="/js/pyramid.js"></script>
    <%- include('partials/analytics') %>
</body>
</html>
